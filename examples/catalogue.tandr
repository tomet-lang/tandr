// =======================================================================
// tandr Rules Catalogue
// =======================================================================
// A comprehensive collection of structural search, rewrite, and formatting
// rules written in cotomet syntax (Style A).
//
// Rules demonstrate tomet's slot syntax <?...>, typed holes, and declaration patterns.
// (Note: `where:` guards are experimental syntax targets for future guard engine).

// -----------------------------------------------------------------------
// 1. Metadata and Header Transformations
// -----------------------------------------------------------------------

promote_meta_type: {
    description: "旧式の @meta{type: ...} を第一級の @kind(...) へ昇格する"
    match: "@meta{ type: <?(kind)>, <?rest(rest)> }"
    // where: "${hole.kind} != 'raw'"
    replace: "@kind(${hole.kind})\n@meta{ ${hole.rest} }"
}

normalize_meta_status: {
    description: "@meta{ draft: true } をステータス表記に正規化"
    match: "@meta{ draft: true, <?rest(rest)> }"
    replace: "@meta{ status: \"draft\", ${hole.rest} }"
}

// -----------------------------------------------------------------------
// 2. Link and Reference Normalization
// -----------------------------------------------------------------------

add_external_link_attributes: {
    description: "外部リンクに rel 属性を付与して安全性を高める"
    match: "@link(url: <?(u)>, <?rest(rest)>)[ <?(text)> ]"
    // where: "${hole.u} =~ '^https?://'"
    replace: "@link(url: ${hole.u}, rel: \"external\", ${hole.rest})[ ${hole.text} ]"
}

canonicalize_link_keys: {
    description: "link の target キーを url キーへ統一する"
    match: "@link(target: <?(target)>, <?rest(rest)>)[ <?(text)> ]"
    replace: "@link(url: ${hole.target}, ${hole.rest})[ ${hole.text} ]"
}

// -----------------------------------------------------------------------
// 3. Task and Item Standardization
// -----------------------------------------------------------------------

normalize_task_arguments: {
    description: "単一スカラの @task(todo) を明示的な引数 @task(status: 'todo') へ統一"
    match: "@task(<?(status)>)[ <?(body)> ]"
    // where: "${hole.status} in list('todo', 'wip', 'done')"
    replace: "@task(status: ${hole.status})[ ${hole.body} ]"
}

mark_wip_tasks: {
    description: "ドラフトセクションのタスクを WIP 状態に統一"
    match: "@task(status: \"todo\")[ <?(body)> ]"
    replace: "@task(status: \"wip\")[ ${hole.body} ]"
}

// -----------------------------------------------------------------------
// 4. Element Renaming and Aliasing
// -----------------------------------------------------------------------

rename_note_to_callout: {
    description: "非推奨になった @note を @callout(type: 'info') に書き換える"
    match: "@note[ <?(body)> ]"
    replace: "@callout(type: \"info\")[ ${hole.body} ]"
}

rename_warn_to_callout: {
    description: "@warn を @callout(type: 'warning') に書き換える"
    match: "@warn[ <?(body)> ]"
    replace: "@callout(type: \"warning\")[ ${hole.body} ]"
}

// -----------------------------------------------------------------------
// 5. Typed Holes & Semantic Validation (tomet-type)
// -----------------------------------------------------------------------

upgrade_version: {
    description: "セマンティックバージョンに適合するパッケージの引数を正規化"
    match: "@pkg(name: <?(name)>, ver: <?version(v)>)"
    replace: "@pkg(${hole.name}, version: ${hole.v})"
}

normalize_datetime: {
    description: "ISO 8601 / RFC 3339 日付・日時を timestamp 形式に統一"
    match: "@event(at: <?datetime(d)>, <?rest(r)>)"
    replace: "@event(timestamp: ${hole.d}, ${hole.r})"
}

standardize_metric: {
    description: "非負整数カウントを total フィールドに統一"
    match: "@metric(name: <?(name)>, count: <?uint(c)>)"
    replace: "@metric(${hole.name}, total: ${hole.c})"
}

anonymously_check_uuid: {
    description: "有効な UUID を持つエンティティに verified フラグを付与"
    match: "@entity(id: <?uuid>, <?rest(r)>)"
    replace: "@entity(verified: true, ${hole.r})"
}

// -----------------------------------------------------------------------
// 6. Document Declarations and Universal Elements
// -----------------------------------------------------------------------

canonicalize_config_declaration: {
    description: "文書設定宣言 ::config{ env: ... } を ::environment(...) に昇格"
    match: "::config{ env: <?(e)> }"
    replace: "::environment(${hole.e})"
}

capture_any_legacy_element: {
    description: "legacy: true を持つ任意の要素を @deprecated に変換"
    match: "<?element(tag, legacy: true)>"
    replace: "@deprecated(original: ${hole.tag})"
}

// -----------------------------------------------------------------------
// 7. Future Targets (Code Blocks & Containers)
// -----------------------------------------------------------------------

